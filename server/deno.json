{
  "workspace": ["./supabase/functions"],
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@std/encoding": "jsr:@std/encoding@1.0.10",
    "@std/encoding/": "jsr:/@std/encoding@1.0.10/",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@0.4.6"
  },
  "tasks": {
    "test": "deno test -A tests/",
    "check": "deno check supabase/functions/*/index.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "proseWrap": "preserve",
    "exclude": ["tests/fixtures", "supabase/.temp"]
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  }
}
