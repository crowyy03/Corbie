    "paywall.legal.generic": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium verlängert sich selbst, bis du die automatische Verlängerung in den App-Store-Einstellungen ausschaltest, spätestens 24 Stunden vor Ende der Laufzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium renews itself until you turn auto-renew off in App Store settings, at least 24 hours before the period ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium se renueva solo hasta que desactives la renovación automática en los ajustes de la App Store, al menos 24 horas antes de que acabe el periodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium se renouvelle tout seul jusqu'à ce que vous désactiviez le renouvellement automatique dans les réglages de l'App Store, au moins 24 heures avant la fin de la période."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium si rinnova da solo finché non disattivi il rinnovo automatico nelle impostazioni dell'App Store, almeno 24 ore prima della fine del periodo."
          }
        }
      }
    },
    "paywall.legal.monthly": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium kostet %@ im Monat. Deine Apple-ID wird bei der Bestätigung belastet und danach jeden Monat, sofern du die automatische Verlängerung nicht spätestens 24 Stunden vor Monatsende ausschaltest. Verwaltung in den App-Store-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium is %@ a month. Your Apple ID is charged when you confirm, and again every month unless you turn auto-renew off at least 24 hours before the month ends. Manage it in App Store settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium cuesta %@ al mes. Se cobra a tu Apple ID al confirmar y luego cada mes, salvo que desactives la renovación automática al menos 24 horas antes de que acabe el mes. Se gestiona en los ajustes de la App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium coûte %@ par mois. Votre identifiant Apple est débité à la confirmation, puis chaque mois, sauf si vous désactivez le renouvellement automatique au moins 24 heures avant la fin du mois. Gestion dans les réglages de l'App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium costa %@ al mese. L'addebito sul tuo Apple ID avviene alla conferma e poi ogni mese, a meno che tu non disattivi il rinnovo automatico almeno 24 ore prima della fine del mese. Si gestisce nelle impostazioni dell'App Store."
          }
        }
      }
    },
    "paywall.legal.yearly": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium kostet %@ im Jahr. Deine Apple-ID wird bei der Bestätigung belastet und danach jedes Jahr, sofern du die automatische Verlängerung nicht spätestens 24 Stunden vor Jahresende ausschaltest. Verwaltung in den App-Store-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium is %@ a year. Your Apple ID is charged when you confirm, and again every year unless you turn auto-renew off at least 24 hours before the year ends. Manage it in App Store settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium cuesta %@ al año. Se cobra a tu Apple ID al confirmar y luego cada año, salvo que desactives la renovación automática al menos 24 horas antes de que acabe el año. Se gestiona en los ajustes de la App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium coûte %@ par an. Votre identifiant Apple est débité à la confirmation, puis chaque année, sauf si vous désactivez le renouvellement automatique au moins 24 heures avant la fin de l'année. Gestion dans les réglages de l'App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie Premium costa %@ all'anno. L'addebito sul tuo Apple ID avviene alla conferma e poi ogni anno, a meno che tu non disattivi il rinnovo automatico almeno 24 ore prima della fine dell'anno. Si gestisce nelle impostazioni dell'App Store."
          }
        }
      }
    },
