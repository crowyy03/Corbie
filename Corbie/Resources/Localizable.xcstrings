    "settings.account.delete.note": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Raum, der dir gehört, geht mit. Dieses iPhone wird geleert und du wirst abgemeldet. Es gibt kein Zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The space you own goes with it, this phone is wiped and you are signed out. There is no undo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio que es tuyo se va con ella, este iPhone se vacía y se cierra tu sesión. No hay vuelta atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace qui vous appartient part avec, cet iPhone est vidé et vous êtes déconnecté. Rien ne revient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio che è tuo se ne va con lui, questo iPhone viene svuotato e ti disconnetti. Non si torna indietro."
          }
        }
      }
    },
