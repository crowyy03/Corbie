    "goals.empty.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was habt ihr vor? Eine Reise, eine Küche, eine Hochzeit, ein Auto. Betrag setzen, Rest sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are you two up to? A trip, a kitchen, a wedding, a car. Set the amount, see what is left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál es el próximo plan? Un viaje, una cocina, una boda, un coche. Pon la cantidad y mira lo que falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous préparez quoi ? Un voyage, une cuisine, un mariage, une voiture. Fixez le montant, voyez ce qui reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa avete in mente? Un viaggio, una cucina, un matrimonio, un'auto. Metti l'importo e guarda cosa manca."
          }
        }
      }
    },
