{
  "sourceLanguage": "en",
  "strings": {
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie liest deinen Kalender für die Zeiten, in denen ihr beide frei seid, und trägt eure gemeinsamen Termine ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie reads your calendar for the times you two are free, and writes the dates you keep together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie lee tu calendario para ver cuándo estáis libres los dos y escribe las fechas que lleváis juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie lit votre agenda pour trouver quand vous êtes libres tous les deux, et écrit les dates que vous tenez ensemble."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbie legge il tuo calendario per trovare quando siete liberi tutti e due e scrive le date che tenete insieme."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Termin aus Corbie in deinen iPhone-Kalender eintragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an event from Corbie to your iPhone calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir una fecha de Corbie al calendario del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une date de Corbie au calendrier de l'iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungere una data di Corbie al calendario di iPhone."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Foto für einen Wunsch auswählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a photo for a wish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir una foto para un deseo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une photo pour un souhait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegliere una foto per un desiderio."
          }
        }
      }
    }
  },
  "version": "1.0"
}
